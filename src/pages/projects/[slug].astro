---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");

  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project }
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---

<BaseLayout
  title={`${project.data.title} | Project Case Study`}
  description={project.data.seoDescription ?? project.data.summary}
>
  <section class="shell py-20">
    <a href="/projects" class="text-sm text-accent hover:text-white">← Back to projects</a>
    <div class="mt-8 grid gap-12 lg:grid-cols-[1.15fr_0.85fr]">
      <article>
        <p class="eyebrow">{project.data.category}</p>
        <h1 class="mt-6 text-4xl font-bold tracking-tight text-white sm:text-5xl">{project.data.title}</h1>
        <p class="mt-6 max-w-3xl text-lg leading-8 text-mist/75">{project.data.summary}</p>

        <div class="mt-10 space-y-6 text-base leading-8 text-mist/75 [&_h2]:mt-10 [&_h2]:text-2xl [&_h2]:font-semibold [&_h2]:text-white [&_li]:ml-5 [&_li]:list-disc [&_p]:text-mist/75 [&_strong]:text-white [&_ul]:space-y-2">
          <Content />
        </div>
      </article>

      <aside class="space-y-6">
        <div class="panel p-6">
          <h2 class="text-lg font-semibold text-white">Project data</h2>
          <dl class="mt-5 space-y-4 text-sm">
            <div class="flex justify-between gap-6 border-b border-white/10 pb-4">
              <dt class="text-mist/55">Client</dt>
              <dd class="text-right text-white">{project.data.client}</dd>
            </div>
            <div class="flex justify-between gap-6 border-b border-white/10 pb-4">
              <dt class="text-mist/55">Location</dt>
              <dd class="text-right text-white">{project.data.location}</dd>
            </div>
            <div class="flex justify-between gap-6 border-b border-white/10 pb-4">
              <dt class="text-mist/55">Published</dt>
              <dd class="text-right text-white">{project.data.publishDate.toLocaleDateString("en-US", { year: "numeric", month: "long" })}</dd>
            </div>
            <div>
              <dt class="text-mist/55">Stack</dt>
              <dd class="mt-3 flex flex-wrap gap-2">
                {project.data.stack.map((item) => <span class="rounded-full bg-white/5 px-3 py-1 text-xs text-mist/75">{item}</span>)}
              </dd>
            </div>
          </dl>
        </div>

        <div class="panel p-6">
          <h2 class="text-lg font-semibold text-white">Outcomes</h2>
          <div class="mt-5 grid gap-4 sm:grid-cols-2 lg:grid-cols-1">
            {project.data.metrics.map((metric) => (
              <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
                <p class="text-2xl font-bold text-white">{metric.value}</p>
                <p class="mt-1 text-sm text-mist/65">{metric.label}</p>
              </div>
            ))}
          </div>
        </div>
      </aside>
    </div>
  </section>
</BaseLayout>
